<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5e_vla_description</name>
  <version>0.1.0</version>
  <description>
    Robot description (URDF/xacro) of the robotic cell: a UR5e with a Robotiq
    2F-85 gripper mounted on the tool flange. Provides a single robot
    description for one controller_manager.
  </description>
  <maintainer email="cybercoffeedev@proton.me">cybercoffeedev</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
